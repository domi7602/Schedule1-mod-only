# Build artifacts
**/bin/
**/obj/
*.dll
*.pdb
*.exe
*.deps.json
*.runtimeconfig.json
*.assets
*.manifest

# Game-side folders (never commit). These live in the game install dir,
# i.e. OUTSIDE this worktree — they are root-anchored so they can never
# shadow repo subpaths (bugfix 2026-09-16: unanchored "Mods/" silently
# ignored every new file under Source/Mods/).
/game source/
/Library/
/Temp/
/Logs/
/UserSettings/
/MelonLoader/
/Mods/
/Plugins/
/UserData/

# Local tooling and generated reverse-engineering references
.cache/
.vs/
TestResults/

# Game research decompiles stay local: only README.md and the nested .gitignore
# are tracked, everything else under GameReferences/ is ignored.
GameReferences/*
!GameReferences/README.md
!GameReferences/.gitignore

# Misc
*.bak
*.orig
*.log
__pycache__/
*.pyc
Thumbs.db
# Release packages (ZIPs and locally extracted test folders)
Release/*.zip
Release/*/

# Archives
Source/Archive/*.zip

# Scratch / WIP / decompile output (never commit)
.scratch/
**/*.tmp.cs
**/scratch/

# Agent-/Tooling-Sandboxes (self-ignoring, hier zusaetzlich hart verankert)
.hermes/
.opencode/

# Lokale Build-Overrides (maschinen-spezifische Pfade, nie committen).
# Beispiel/Format: ThirdParty/S1API/local.build.props <- example.build.props
local.build.props
ThirdParty/**/local.build.props
ThirdParty/**/game_config.json
ThirdParty/**/config.local.json

# Local-only S1MCP server snapshot (untracked 2026-10-02; not part of the
# public repository — obtain it separately, e.g. from ifBars/S1MCPServer).
/ThirdParty/S1MCPServer-master/

.hermes-tmp.*
