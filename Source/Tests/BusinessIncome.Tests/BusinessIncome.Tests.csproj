<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>12</LangVersion>
    <RootNamespace>BusinessIncome.Tests</RootNamespace>
    <AssemblyName>BusinessIncome.Tests</AssemblyName>
    <!-- Auto-include every *.cs in this project directory (all test files). -->
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Pure mod sources under test. These have NO Unity / IL2CPP / S1API / MelonLoader
    dependency (the A-D financial-safety core plus the payout models), so they link
    straight into the test assembly.

    The runtime glue (IncomeEngine / PayoutStateStore / Mod / BusinessConsoleCommand)
    and the native BusinessResolver are deliberately NOT linked here - they touch
    Unity/IL2CPP and are covered by the compile-only integration build instead.
  -->
  <ItemGroup>
    <!-- Paths mirror the mod's src/<Domain>/ layout (WorldLook convention). List them
         explicitly (a src/**/*.cs glob would pull the Unity/IL2CPP runtime glue into
         these tests). -->
    <Compile Include="../../Mods/BusinessIncome/src/Core/FinancialOutcomes.cs" />
    <Compile Include="../../Mods/BusinessIncome/src/Core/LegacyMigration.cs" />
    <Compile Include="../../Mods/BusinessIncome/src/Core/PayoutCodec.cs" />
    <Compile Include="../../Mods/BusinessIncome/src/Core/PayoutLedger.cs" />
    <Compile Include="../../Mods/BusinessIncome/src/Core/PayoutScheduler.cs" />
    <Compile Include="../../Mods/BusinessIncome/src/Core/PayoutSettlementEngine.cs" />
    <Compile Include="../../Mods/BusinessIncome/src/Core/PayoutWindowPlanner.cs" />
    <Compile Include="../../Mods/BusinessIncome/src/Core/Seams.cs" />
    <Compile Include="../../Mods/BusinessIncome/src/Models/PayoutState.cs" />
  </ItemGroup>

  <!--
    Fixed-contract sources owned by other agents, linked only when present so the
    revenue/config test files compile once those files land. Condition on Exists so a
    mid-flight tree still builds.
  -->
  <ItemGroup Condition="Exists('../../Mods/BusinessIncome/src/Models/BusinessData.cs')">
    <Compile Include="../../Mods/BusinessIncome/src/Models/BusinessData.cs" />
  </ItemGroup>
  <ItemGroup Condition="Exists('../../Mods/BusinessIncome/src/Models/BusinessRevenueLine.cs')">
    <Compile Include="../../Mods/BusinessIncome/src/Models/BusinessRevenueLine.cs" />
  </ItemGroup>
  <ItemGroup Condition="Exists('../../Mods/BusinessIncome/src/Persistence/ConfigSidecarData.cs')">
    <Compile Include="../../Mods/BusinessIncome/src/Persistence/ConfigSidecarData.cs" />
  </ItemGroup>
  <ItemGroup Condition="Exists('../../Mods/BusinessIncome/src/BusinessIncomeConfig.cs') AND Exists('../../Mods/BusinessIncome/src/Persistence/ConfigSidecarData.cs')">
    <Compile Include="../../Mods/BusinessIncome/src/BusinessIncomeConfig.cs" />
  </ItemGroup>
  <ItemGroup Condition="Exists('../../Mods/BusinessIncome/src/Services/RevenueCalculator.cs') AND Exists('../../Mods/BusinessIncome/src/Models/BusinessData.cs')">
    <Compile Include="../../Mods/BusinessIncome/src/Services/RevenueCalculator.cs" />
  </ItemGroup>

  <!--
    Escape hatch for isolated runs while other agents' sources/tests are still
    landing: pass -p:FinancialOnly=true and a filter of
    "FullyQualifiedName~Financial|FullyQualifiedName~Persistence".
    Excludes the revenue/config test files from compilation for the isolated run;
    the default build (no property) auto-includes every test file.
  -->
  <ItemGroup Condition="'$(FinancialOnly)' == 'true'">
    <Compile Remove="Revenue*.cs" />
  </ItemGroup>

</Project>
