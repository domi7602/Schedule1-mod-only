<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>12</LangVersion>
    <RootNamespace>BusinessIncome.ConfigIo.Tests</RootNamespace>
    <AssemblyName>BusinessIncome.ConfigIo.Tests</AssemblyName>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Production configuration, payout adapters, core and Shared SafeStorage run
       against real files. Only native game/environment boundaries are shimmed.
       Native lifecycle and actual bank settlement still require gameplay tests. -->
  <ItemGroup>
    <Compile Include="..\..\Mods\Shared\src\SafeStorage.cs" Link="Production\SafeStorage.cs" />
    <Compile Include="..\..\Mods\BusinessIncome\src\Core\*.cs" Link="Production\Core\%(Filename)%(Extension)" />
    <Compile Include="..\..\Mods\BusinessIncome\src\PayoutState.cs" Link="Production\PayoutState.cs" />
    <Compile Include="..\..\Mods\BusinessIncome\src\PayoutRuntime.cs" Link="Production\PayoutRuntime.cs" />
    <Compile Include="..\..\Mods\BusinessIncome\src\PayoutStateStore.cs" Link="Production\PayoutStateStore.cs" />
    <Compile Include="..\..\Mods\BusinessIncome\src\IncomeEngine.cs" Link="Production\IncomeEngine.cs" />
    <Compile Include="..\..\Mods\BusinessIncome\src\RevenueCalculator.cs" Link="Production\RevenueCalculator.cs" />
    <Compile Include="..\..\Mods\BusinessIncome\src\BusinessData.cs" Link="Production\BusinessData.cs" />
    <Compile Include="..\..\Mods\BusinessIncome\src\BusinessRevenueLine.cs" Link="Production\BusinessRevenueLine.cs" />
    <Compile Include="..\..\Mods\BusinessIncome\src\ConfigJsonStore.cs" Link="Production\ConfigJsonStore.cs" />
    <Compile Include="..\..\Mods\BusinessIncome\src\ConfigSidecarData.cs" Link="Production\ConfigSidecarData.cs" />
    <Compile Include="..\..\Mods\BusinessIncome\src\BusinessIncomeConfig.cs" Link="Production\BusinessIncomeConfig.cs" />
  </ItemGroup>

</Project>
