<Project>
  <!-- Deploy convention (since 2026-09 reinstall): -->
  <!--   <GameDir>\Mods\              -> DLL + PNGs + Bundles (only loadable by MelonLoader) -->
  <!--   <GameDir>\UserData\<Mod>\    -> mod.json (metadata) + <Mod>.pdb (debug symbols) -->
  <!-- SkipUnchangedFiles=false forces deploy on every build (fix for stale DLLs in GameDir). -->
  <!-- Build without deploy (CI, compile-only checks): -p:S1NoDeploy=true  or  $env:S1NoDeploy='true'. -->
  <Target Name="DeployMod" AfterTargets="Build" Condition="'$(S1NoDeploy)' != 'true' And Exists('$(TargetPath)')">
    <PropertyGroup>
      <_DeployDir>$(ModsDir)</_DeployDir>
      <_UserLibsDir>$(GameDir)\UserLibs</_UserLibsDir>
      <_ModDataDir>$(UserDataDir)\$(MSBuildProjectName)</_ModDataDir>
      <_PdbPath>$([System.IO.Path]::ChangeExtension('$(TargetPath)', '.pdb'))</_PdbPath>
    </PropertyGroup>
    <MakeDir Directories="$(_DeployDir)" Condition="!Exists('$(_DeployDir)')" />
    <MakeDir Directories="$(_ModDataDir)" Condition="!Exists('$(_ModDataDir)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(_DeployDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(_PdbPath)" DestinationFolder="$(_ModDataDir)" SkipUnchangedFiles="false" Condition="Exists('$(_PdbPath)')" />
    <ItemGroup>
      <_Pngs Include="$(MSBuildProjectDirectory)\*.png;$(MSBuildProjectDirectory)\..\assets\*.png" />
      <_Bundles Include="$(MSBuildProjectDirectory)\..\assets\*.bundle" Condition="Exists('$(MSBuildProjectDirectory)\..\assets')" />
      <_Glbs Include="$(MSBuildProjectDirectory)\..\assets\*.glb" Condition="Exists('$(MSBuildProjectDirectory)\..\assets')" />
      <_Json Include="$(MSBuildProjectDirectory)\..\docs\mod.json" Condition="Exists('$(MSBuildProjectDirectory)\..\docs\mod.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(_Pngs)" DestinationFolder="$(_DeployDir)" SkipUnchangedFiles="false" Condition="'@(_Pngs)' != ''" />
    <Copy SourceFiles="@(_Bundles)" DestinationFolder="$(_DeployDir)" SkipUnchangedFiles="false" Condition="'@(_Bundles)' != ''" />
    <!-- GLB meshes do NOT land in Mods\ (MelonLoader scans only DLLs) — data subfolder Mods\<Mod>\, runtime paths resolved there. -->
    <Copy SourceFiles="@(_Glbs)" DestinationFolder="$(_DeployDir)\$(MSBuildProjectName)" SkipUnchangedFiles="false" Condition="'@(_Glbs)' != ''" />
    <Copy SourceFiles="@(_Json)" DestinationFiles="$(_ModDataDir)\mod.json" SkipUnchangedFiles="false" Condition="'@(_Json)' != ''" />
    <Message Importance="high" Text="Deployed $(MSBuildProjectName) -> $(_DeployDir) (+ json/pdb -> $(_ModDataDir))" />
  </Target>

  <!-- Shared.dll is not transitively propagated (Private=false) — deploy explicitly. -->
  <Target Name="DeployShared" AfterTargets="Build" Condition="'$(S1NoDeploy)' != 'true' And '$(MSBuildProjectName)' == 'Shared' And Exists('$(TargetPath)')">
    <PropertyGroup>
      <_DeployDir>$(ModsDir)</_DeployDir>
    </PropertyGroup>
    <MakeDir Directories="$(_DeployDir)" Condition="!Exists('$(_DeployDir)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(_DeployDir)" SkipUnchangedFiles="false" />
    <Message Importance="high" Text="Deployed Shared (forced) -> $(_DeployDir)" />
  </Target>

  <!--
    ThirdParty deploy: iterate all *.dll under ThirdParty/ and copy
    them force-deploy to <GameDir>\Mods\ (whitelist via ThirdParty/.deployignore).
    Runs only once with Shared, since all mods depend on Shared.
  -->
  <Target Name="DeployThirdParty" AfterTargets="Build" Condition="'$(S1NoDeploy)' != 'true' And '$(MSBuildProjectName)' == 'Shared' And Exists('$(TargetPath)')">
    <PropertyGroup>
      <_TpScript>$(MSBuildThisFileDirectory)..\..\Tools\deploy-thirdparty.ps1</_TpScript>
    </PropertyGroup>
    <Message Importance="low" Text="[DeployThirdParty] running $(_TpScript)..." />
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(_TpScript)&quot;" />
  </Target>
</Project>
