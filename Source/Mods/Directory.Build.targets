<Project>
  <!-- Deploy convention (since 2026-09 reinstall): -->
  <!--   <GameDir>\Mods\              -> DLL + PNGs + Bundles (only loadable by MelonLoader) -->
  <!--   <GameDir>\Mods\<Mod>\        -> GLB meshes (MelonLoader scans only DLLs) -->
  <!--   <GameDir>\UserData\<Mod>\    -> mod.json (metadata) + <Mod>.pdb (debug symbols) -->
  <!-- Build without deploy (CI, compile-only checks): -p:S1NoDeploy=true  or  $env:S1NoDeploy='true'. -->
  <!--
    Every write into the install goes through Tools/deploy-mod.ps1. The script derives the
    complete per-project file plan (DLL, PDB, mod.json, icons, bundles, GLBs), runs
    check-deploy-preflight.ps1 inside a per-install mutex, backs up only the targets it
    overwrites (<GameDir>\UserData\.deploy\backups\), verifies SHA256 after each copy and
    writes a receipt with exact paths/hashes + git revision and dirty state
    (<GameDir>\UserData\.deploy\receipts\<Mod>.json). An in-process failure restores the
    touched targets from the verified backup; there is no cross-process crash atomicity.
  -->
  <PropertyGroup>
    <S1NoDeploy Condition="'$(NoDeploy)' == 'true'">true</S1NoDeploy>
    <_S1DeployModScript>$(MSBuildThisFileDirectory)..\..\Tools\deploy-mod.ps1</_S1DeployModScript>
    <_S1DeployThirdPartyScript>$(MSBuildThisFileDirectory)..\..\Tools\deploy-thirdparty.ps1</_S1DeployThirdPartyScript>
    <!-- Pass the exact GameDir the build resolved (property > SCHEDULE1_PATH > default),
         without a trailing separator before the closing quote. -->
    <_S1EffectiveGameDir>$([System.IO.Path]::TrimEndingDirectorySeparator('$(GameDir)'))</_S1EffectiveGameDir>
    <!-- The deploy script owns plan derivation; these are the conventional inputs. -->
    <_S1DeployProjectDir>$(MSBuildProjectDirectory)</_S1DeployProjectDir>
    <_S1DeployAssetsDir>$(MSBuildProjectDirectory)\..\assets</_S1DeployAssetsDir>
    <_S1DeployModJson>$(MSBuildProjectDirectory)\..\docs\mod.json</_S1DeployModJson>
  </PropertyGroup>

  <Target Name="DeployMod" AfterTargets="Build" Condition="'$(S1NoDeploy)' != 'true' And '$(MSBuildProjectName)' != 'Shared' And Exists('$(TargetPath)')">
    <Exec Command="pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(_S1DeployModScript)&quot; -GameDir &quot;$(_S1EffectiveGameDir)&quot; -ProjectName &quot;$(MSBuildProjectName)&quot; -Configuration &quot;$(Configuration)&quot; -TargetPath &quot;$(TargetPath)&quot; -ProjectDir &quot;$(_S1DeployProjectDir)&quot; -AssetsDir &quot;$(_S1DeployAssetsDir)&quot; -ModJsonPath &quot;$(_S1DeployModJson)&quot;" />
  </Target>

  <!-- Shared.dll is not transitively propagated (Private=false) — deploy it once, explicitly,
       through the same receipt/rollback path as every other project. -->
  <Target Name="DeployShared" AfterTargets="Build" Condition="'$(S1NoDeploy)' != 'true' And '$(MSBuildProjectName)' == 'Shared' And Exists('$(TargetPath)')">
    <Exec Command="pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(_S1DeployModScript)&quot; -GameDir &quot;$(_S1EffectiveGameDir)&quot; -ProjectName &quot;Shared&quot; -Configuration &quot;$(Configuration)&quot; -TargetPath &quot;$(TargetPath)&quot; -ProjectDir &quot;$(_S1DeployProjectDir)&quot; -AssetsDir &quot;$(_S1DeployAssetsDir)&quot; -ModJsonPath &quot;$(_S1DeployModJson)&quot;" />
  </Target>

  <!--
    ThirdParty deploy: opt-in only, deliberately separate from the mod plan.
    Tools/deploy-thirdparty.ps1 reads the explicit allowlist ThirdParty/.deployallow
    (empty by default), re-runs the game-running preflight itself, and verifies
    SHA256 after each copy. Runs only once with Shared, since all mods depend on Shared.
  -->
  <Target Name="DeployThirdParty" AfterTargets="Build" Condition="'$(S1NoDeploy)' != 'true' And '$(MSBuildProjectName)' == 'Shared' And Exists('$(TargetPath)')">
    <Message Importance="low" Text="[DeployThirdParty] running $(_S1DeployThirdPartyScript)..." />
    <Exec Command="pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(_S1DeployThirdPartyScript)&quot; -GameDir &quot;$(_S1EffectiveGameDir)&quot;" />
  </Target>
</Project>
