<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>HitmanPhone</AssemblyName>
    <RootNamespace>HitmanPhone</RootNamespace>
    <DefineConstants>$(DefineConstants);IL2CPPMELON</DefineConstants>
  </PropertyGroup>

  <!-- PNG asset: lives in ../assets/ (keeps src/ pure .cs); Directory.Build.targets
       deploys it next to the DLL into <GameDir>\Mods\ via its assets\*.png glob. -->
  <ItemGroup>
    <None Include="..\assets\polaroid.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
