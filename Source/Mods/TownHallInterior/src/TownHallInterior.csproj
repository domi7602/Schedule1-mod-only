    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(S1TownHallBusinessInterface)' == 'true'">
    <DefineConstants>$(DefineConstants);TOWNHALL_BUSINESS_PROBE;TOWNHALL_BUSINESS_SUBTYPE;TOWNHALL_BUSINESS_INTERFACE</DefineConstants>
